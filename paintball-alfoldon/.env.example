# Copy this file to `.env` and fill in only what you need. Every variable is optional:
# without any of them the map uses CARTO's free Dark Matter vector tiles (attribution required,
# already rendered on the map), recolored to pure black at load time.
#
# `npm install`, `npm start`, `npm run build` and `npm test` regenerate
# src/environments/environment.ts from this file (see scripts/set-env.mjs).
# Real environment variables take precedence over values in this file.

# Optional — MapTiler API key (https://cloud.maptiler.com/account/keys/).
# When set, the map loads MapTiler's "dataviz-dark" style instead of CARTO's (still recolored to black).
MAPTILER_API_KEY=

# Optional — any MapLibre-compatible style.json URL (Mapbox-style spec v8). Overrides both defaults above.
MAP_STYLE_URL=
